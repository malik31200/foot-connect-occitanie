    USER {
        bigint id PK
        varchar email UK
        varchar username UK
        varchar password "haché PBKDF2"
        varchar role "user | admin"
        varchar sport_role "joueur | coach | supporter | club | partenaire"
        varchar avatar_url
        varchar club_name
        bool is_active
        timestamp date_joined
    }
    PASSWORD_RESET_TOKEN {
        bigint id PK
        bigint user_id FK
        varchar code "6 chiffres"
        timestamp created_at
    }
    DAILY_ACTIVITY {
        bigint id PK
        bigint user_id FK "UK avec date"
        date date
    }
    CLUB {
        bigint id PK
        varchar name
        varchar city
        varchar stadium
        varchar logo_url
        varchar fff_id UK
    }
    TEAM {
        bigint id PK
        bigint club_id FK
        varchar name
        varchar category
        varchar group_name
        varchar season
        varchar fff_id UK
    }
    MATCH {
        bigint id PK
        bigint home_team_id FK
        bigint away_team_id FK
        varchar category
        varchar season
        varchar group_name
        int matchday
        timestamp date_time "UTC"
        varchar venue
        varchar status "scheduled | finished | postponed"
        int home_score
        int away_score
        varchar source "fff | manual"
        varchar fff_id UK
        bool is_locked
    }
    STANDING {
        bigint id PK
        bigint team_id FK "UK avec category, season, group_name"
        varchar category
        varchar season
        varchar group_name
        int played
        int won
        int draw
        int lost
        int goals_for
        int goals_against
        int goal_diff
        int points
        int rank
    }
    POST {
        bigint id PK
        bigint author_id FK
        bigint match_id FK "nullable"
        text caption
        int likes_count
        timestamp created_at
    }
    POST_MEDIA {
        bigint id PK
        bigint post_id FK
        varchar media_type "photo | video"
        varchar media_url "Cloudflare R2"
        int order
    }
    COMMENT {
        bigint id PK
        bigint post_id FK
        bigint author_id FK
        bigint parent_id FK "nullable"
        text content
        bool is_edited
        timestamp created_at
    }
    LIKE {
        bigint id PK
        bigint user_id FK "UK avec post_id"
        bigint post_id FK
    }
    COMMENT_LIKE {
        bigint id PK
        bigint user_id FK "UK avec comment_id"
        bigint comment_id FK
    }
    FOLLOW {
        bigint id PK
        bigint follower_id FK "UK avec following_id"
        bigint following_id FK
    }
    BLOCK {
        bigint id PK
        bigint blocker_id FK "UK avec blocked_id"
        bigint blocked_id FK
    }
    REPORT {
        bigint id PK
        bigint reporter_id FK "UK avec post_id"
        bigint post_id FK
        varchar reason "spam | inappropriate | harassment | other"
    }
    COMMENT_REPORT {
        bigint id PK
        bigint reporter_id FK "UK avec comment_id"
        bigint comment_id FK
        varchar reason
    }
    CONVERSATION {
        bigint id PK
        bigint user1_id FK
        bigint user2_id FK
        timestamp updated_at
    }
    MESSAGE {
        bigint id PK
        bigint conversation_id FK
        bigint sender_id FK
        text content
        bool is_read
        timestamp created_at
    }
